#pragma kernel GenerateDensity
#pragma kernel GenerateMesh

float3 mod289(float3 x)
{
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}
float4 mod289(float4 x)
{
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}
float4 permute(float4 x)
{
    return mod289(((x * 34.0) + 1.0) * x);
}
float4 taylorInvSqrt(float4 r)
{
    return 1.79284291400159 - 0.85373472095314 * r;
}

float snoise(float3 v)
{
    const float2 C = float2(1.0 / 6.0, 1.0 / 3.0);
    const float4 D = float4(0.0, 0.5, 1.0, 2.0);

    float3 i = floor(v + dot(v, C.yyy));
    float3 x0 = v - i + dot(i, C.xxx);

    float3 g = step(x0.yzx, x0.xyz);
    float3 l = 1.0 - g;
    float3 i1 = min(g.xyz, l.zxy);
    float3 i2 = max(g.xyz, l.zxy);

    float3 x1 = x0 - i1 + C.xxx;
    float3 x2 = x0 - i2 + C.yyy;
    float3 x3 = x0 - D.yyy;

    i = mod289(i);
    float4 p = permute(permute(permute(
        i.z + float4(0.0, i1.z, i2.z, 1.0))
        + i.y + float4(0.0, i1.y, i2.y, 1.0))
        + i.x + float4(0.0, i1.x, i2.x, 1.0));

    float n_ = 0.142857142857;
    float3 ns = n_ * D.wyz - D.xzx;

    float4 j = p - 49.0 * floor(p * ns.z * ns.z);

    float4 x_ = floor(j * ns.z);
    float4 y_ = floor(j - 7.0 * x_);

    float4 x = x_ * ns.x + ns.yyyy;
    float4 y = y_ * ns.x + ns.yyyy;
    float4 h = 1.0 - abs(x) - abs(y);

    float4 b0 = float4(x.xy, y.xy);
    float4 b1 = float4(x.zw, y.zw);

    float4 s0 = floor(b0) * 2.0 + 1.0;
    float4 s1 = floor(b1) * 2.0 + 1.0;
    float4 sh = -step(h, float4(0.0, 0.0, 0.0, 0.0));

    float4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
    float4 a1 = b1.xzyw + s1.xzyw * sh.zzww;

    float3 p0 = float3(a0.xy, h.x);
    float3 p1 = float3(a0.zw, h.y);
    float3 p2 = float3(a1.xy, h.z);
    float3 p3 = float3(a1.zw, h.w);

    float4 norm = taylorInvSqrt(float4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
    p0 *= norm.x;
    p1 *= norm.y;
    p2 *= norm.z;
    p3 *= norm.w;

    float4 m = max(0.6 - float4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
    m = m * m;
    return 42.0 * dot(m * m, float4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
}

struct Triangle
{
    float3 a, b, c;
};

RWStructuredBuffer<float> Densities;
AppendStructuredBuffer<Triangle> Triangles;

StructuredBuffer<int2> EdgeVertices;
StructuredBuffer<int> TriTable;
StructuredBuffer<int3> Corners;

int3 ChunkSize;
int3 WorldOffset;
float IsoLevel;

float _Seed;
float _BiomeScale;
float _OceanHeight;
float _PlainsHeight;
float _MountainHeight;
float _HubScale;
float _HubThreshold;
float _BranchScale;
float _BranchThreshold;

int GetIndex(int3 pos)
{
    return pos.x + pos.y * ChunkSize.x + pos.z * ChunkSize.x * ChunkSize.y;
}

[numthreads(8, 8, 8)]
void GenerateDensity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) ChunkSize.x || id.y >= (uint) ChunkSize.y || id.z >= (uint) ChunkSize.z)
        return;

    float3 worldPos = float3(id.x, id.y, id.z) + float3(WorldOffset.x, WorldOffset.y, WorldOffset.z);
    
    float3 posForNoise = float3(worldPos.x + _Seed, 0.0, worldPos.z + _Seed);
    float biomeNoise = snoise(posForNoise * _BiomeScale);
    
    float targetHeight = lerp(_OceanHeight, _PlainsHeight, smoothstep(-0.2, 0.1, biomeNoise));
    targetHeight = lerp(targetHeight, _MountainHeight, smoothstep(0.3, 0.8, biomeNoise));

    float density = targetHeight - worldPos.y;
    density = clamp(density, -15.0, 15.0);

    float3 hubPos = worldPos * _HubScale;
    hubPos.y *= 2.5;
    float3 hubPosNoise = float3(hubPos.x + _Seed, hubPos.y + _Seed, hubPos.z + _Seed);
    float hNoise = snoise(hubPosNoise);
    float hubMask = smoothstep(_HubThreshold, _HubThreshold + 0.05, hNoise);

    float3 bPos1 = worldPos * float3(_BranchScale, _BranchScale * 4.0, _BranchScale);
    float3 bPos2 = (worldPos + float3(123.0, 456.0, 789.0)) * float3(_BranchScale, _BranchScale * 4.0, _BranchScale);
    
    float n1 = snoise(bPos1);
    float n2 = snoise(bPos2);
    float branchShape = (n1 * n1) + (n2 * n2);
    
    float bEdge = _BranchThreshold - 0.01;
    float branchMask = smoothstep(bEdge, _BranchThreshold, branchShape);
    branchMask = 1.0 - branchMask;

    float caveMask = max(hubMask, branchMask);
    float surfaceMask = smoothstep(3.0, 8.0, targetHeight - worldPos.y);
    caveMask *= surfaceMask;

    density = lerp(density, -10.0, caveMask);
    
    if (worldPos.y < -30.0)
    {
        density = 20.0;
    }

    Densities[GetIndex(int3(id.x, id.y, id.z))] = density;
}

float3 Interpolate(float3 p1, float val1, float3 p2, float val2)
{
    if (abs(IsoLevel - val1) < 0.00001)
        return p1;
    if (abs(IsoLevel - val2) < 0.00001)
        return p2;
    if (abs(val1 - val2) < 0.00001)
        return p1;
    float mu = (IsoLevel - val1) / (val2 - val1);
    return p1 + mu * (p2 - p1);
}

[numthreads(8, 8, 8)]
void GenerateMesh(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) (ChunkSize.x - 1) || id.y >= (uint) (ChunkSize.y - 1) || id.z >= (uint) (ChunkSize.z - 1))
        return;

    float cubeDensities[8];
    int cubeIndex = 0;
    int3 basePos = int3(id.x, id.y, id.z);

    for (int i = 0; i < 8; i++)
    {
        int3 cornerPos = basePos + Corners[i];
        float d = Densities[GetIndex(cornerPos)];
        cubeDensities[i] = d;
        if (d > IsoLevel)
        {
            cubeIndex |= (1 << i);
        }
    }

    if (cubeIndex == 0 || cubeIndex == 255)
        return;

    float3 edgeVertices[12];
    for (int j = 0; j < 12; j++)
    {
        int2 edge = EdgeVertices[j];
        
        int3 cornerA = Corners[edge.x];
        int3 cornerB = Corners[edge.y];
        
        float3 p1 = float3(basePos.x + cornerA.x, basePos.y + cornerA.y, basePos.z + cornerA.z);
        float3 p2 = float3(basePos.x + cornerB.x, basePos.y + cornerB.y, basePos.z + cornerB.z);
        
        float v1 = cubeDensities[edge.x];
        float v2 = cubeDensities[edge.y];
        
        edgeVertices[j] = Interpolate(p1, v1, p2, v2);
    }

    int tableOffset = cubeIndex * 16;
    for (int k = 0; k < 16; k += 3)
    {
        int a = TriTable[tableOffset + k];
        if (a == -1)
            break;

        int b = TriTable[tableOffset + k + 1];
        int c = TriTable[tableOffset + k + 2];

        Triangle tri;
        tri.a = edgeVertices[a];
        tri.b = edgeVertices[b];
        tri.c = edgeVertices[c];
        
        Triangles.Append(tri);
    }
}

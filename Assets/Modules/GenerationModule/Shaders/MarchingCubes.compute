#pragma kernel GenerateDensity
#pragma kernel GenerateMesh

// --- SIMPLEX NOISE 3D ---
float3 mod289(float3 x)
{
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}
float4 mod289(float4 x)
{
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}
float4 permute(float4 x)
{
    return mod289(((x * 34.0) + 1.0) * x);
}
float4 taylorInvSqrt(float4 r)
{
    return 1.79284291400159 - 0.85373472095314 * r;
}

float snoise(float3 v)
{
    const float2 C = float2(1.0 / 6.0, 1.0 / 3.0);
    const float4 D = float4(0.0, 0.5, 1.0, 2.0);
    float3 i = floor(v + dot(v, C.yyy));
    float3 x0 = v - i + dot(i, C.xxx);
    float3 g = step(x0.yzx, x0.xyz);
    float3 l = 1.0 - g;
    float3 i1 = min(g.xyz, l.zxy);
    float3 i2 = max(g.xyz, l.zxy);
    float3 x1 = x0 - i1 + C.xxx;
    float3 x2 = x0 - i2 + C.yyy;
    float3 x3 = x0 - D.yyy;
    i = mod289(i);
    float4 p = permute(permute(permute(i.z + float4(0.0, i1.z, i2.z, 1.0)) + i.y + float4(0.0, i1.y, i2.y, 1.0)) + i.x + float4(0.0, i1.x, i2.x, 1.0));
    float n_ = 0.142857142857;
    float3 ns = n_ * D.wyz - D.xzx;
    float4 j = p - 49.0 * floor(p * ns.z * ns.z);
    float4 x_ = floor(j * ns.z);
    float4 y_ = floor(j - 7.0 * x_);
    float4 x = x_ * ns.x + ns.yyyy;
    float4 y = y_ * ns.x + ns.yyyy;
    float4 h = 1.0 - abs(x) - abs(y);
    float4 b0 = float4(x.xy, y.xy);
    float4 b1 = float4(x.zw, y.zw);
    float4 s0 = floor(b0) * 2.0 + 1.0;
    float4 s1 = floor(b1) * 2.0 + 1.0;
    float4 sh = -step(h, float4(0.0, 0.0, 0.0, 0.0));
    float4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
    float4 a1 = b1.xzyw + s1.xzyw * sh.zzww;
    float3 p0 = float3(a0.xy, h.x);
    float3 p1 = float3(a0.zw, h.y);
    float3 p2 = float3(a1.xy, h.z);
    float3 p3 = float3(a1.zw, h.w);
    float4 norm = taylorInvSqrt(float4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
    p0 *= norm.x;
    p1 *= norm.y;
    p2 *= norm.z;
    p3 *= norm.w;
    float4 m = max(0.6 - float4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
    m = m * m;
    return 42.0 * dot(m * m, float4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
}

// --- STRUCTURES ---
struct Biome
{
    float targetTemp;
    float minHeight;
    float maxHeight;
    float detailScale;
    float detailAmplitude;
    float biomeWeightMultiplier;
    float2 padding;
    float4 biomeColor;
};

struct Triangle
{
    float3 a;
    float3 b;
    float3 c;
    float4 colorA;
    float4 colorB;
    float4 colorC;
};

// --- BUFFERS ---
StructuredBuffer<Biome> Biomes;
int BiomeCount;
float BiomeMapScale;
RWStructuredBuffer<float> Densities;
AppendStructuredBuffer<Triangle> Triangles;
StructuredBuffer<int2> EdgeVertices;
StructuredBuffer<int> TriTable;
StructuredBuffer<int3> Corners;

// --- PARAMS ---
int3 ChunkSize;
int3 WorldOffset;
float IsoLevel;
float _Seed;
float _HubScale, _HubThreshold, _BranchScale, _BranchThreshold;

uint GetIndex(uint x, uint y, uint z)
{
    return x + y * (uint) ChunkSize.x + z * (uint) ChunkSize.x * (uint) ChunkSize.y;
}

float4 GetBlendedColor(float3 worldPos)
{
    float3 tempPos = float3(worldPos.x * BiomeMapScale, _Seed, worldPos.z * BiomeMapScale);
    float currentTemp = saturate((snoise(tempPos) + 1.0) / 2.0);
    float4 finalCol = float4(0, 0, 0, 0);
    float totalW = 0.0001;
    for (int i = 0; i < BiomeCount; i++)
    {
        float w = pow(saturate(1.0 - abs(currentTemp - Biomes[i].targetTemp) * Biomes[i].biomeWeightMultiplier), 2.0);
        finalCol += Biomes[i].biomeColor * w;
        totalW += w;
    }
    return finalCol / totalW;
}

float3 Interpolate(float3 p1, float val1, float3 p2, float val2)
{
    if (abs(IsoLevel - val1) < 0.00001)
        return p1;
    if (abs(IsoLevel - val2) < 0.00001)
        return p2;
    if (abs(val1 - val2) < 0.00001)
        return p1;
    return p1 + (IsoLevel - val1) / (val2 - val1) * (p2 - p1);
}

[numthreads(4, 4, 4)]
void GenerateDensity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) ChunkSize.x || id.y >= (uint) ChunkSize.y || id.z >= (uint) ChunkSize.z)
        return;

    float3 worldPos = float3(id) + float3(WorldOffset);
    float3 tempPos = float3(worldPos.x * BiomeMapScale, _Seed, worldPos.z * BiomeMapScale);
    float currentTemp = saturate((snoise(tempPos) + 1.0) / 2.0);

    float bMinH = 0, bMaxH = 0, bDetS = 0, bDetA = 0, totalW = 0.0001;
    for (int i = 0; i < BiomeCount; i++)
    {
        float w = pow(saturate(1.0 - abs(currentTemp - Biomes[i].targetTemp) * Biomes[i].biomeWeightMultiplier), 2.0);
        bMinH += Biomes[i].minHeight * w;
        bMaxH += Biomes[i].maxHeight * w;
        bDetS += Biomes[i].detailScale * w;
        bDetA += Biomes[i].detailAmplitude * w;
        totalW += w;
    }
    bMinH /= totalW;
    bMaxH /= totalW;
    bDetS /= totalW;
    bDetA /= totalW;

    float baseH = lerp(bMinH, bMaxH, (snoise(worldPos * 0.012) + 1.0) / 2.0);
    float density = (baseH + snoise(worldPos * bDetS) * bDetA) - worldPos.y;

    float hM = smoothstep(_HubThreshold, _HubThreshold + 0.05, snoise(worldPos * _HubScale + _Seed));
    float3 bP1 = worldPos * float3(_BranchScale, _BranchScale * 4.0, _BranchScale);
    float3 bP2 = (worldPos + float3(123, 456, 789)) * float3(_BranchScale, _BranchScale * 4.0, _BranchScale);
    float bM = 1.0 - smoothstep(_BranchThreshold - 0.01, _BranchThreshold, (snoise(bP1) * snoise(bP1) + snoise(bP2) * snoise(bP2)));

    float surfaceMask = smoothstep(10.0, 20.0, baseH - worldPos.y);
    density = lerp(density, -15.0, max(hM, bM) * surfaceMask);
    if (worldPos.y < -40.0)
        density = 25.0;

    Densities[GetIndex(id.x, id.y, id.z)] = density;
}

[numthreads(4, 4, 4)]
void GenerateMesh(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) (ChunkSize.x - 1) || id.y >= (uint) (ChunkSize.y - 1) || id.z >= (uint) (ChunkSize.z - 1))
        return;

    float dens[8];
    int cubeIdx = 0;
    for (int i = 0; i < 8; i++)
    {
        dens[i] = Densities[GetIndex(id.x + Corners[i].x, id.y + Corners[i].y, id.z + Corners[i].z)];
        if (dens[i] > IsoLevel)
            cubeIdx |= (1 << i);
    }
    if (cubeIdx == 0 || cubeIdx == 255)
        return;

    float3 v[12];
    for (int j = 0; j < 12; j++)
    {
        v[j] = Interpolate(float3(id + Corners[EdgeVertices[j].x]), dens[EdgeVertices[j].x], float3(id + Corners[EdgeVertices[j].y]), dens[EdgeVertices[j].y]);
    }

    int offset = cubeIdx * 16;
    for (int k = 0; k < 16; k += 3)
    {
        if (TriTable[offset + k] == -1)
            break;
        Triangle tri;
        tri.a = v[TriTable[offset + k]];
        tri.b = v[TriTable[offset + k + 1]];
        tri.c = v[TriTable[offset + k + 2]];
        tri.colorA = GetBlendedColor(tri.a + float3(WorldOffset));
        tri.colorB = GetBlendedColor(tri.b + float3(WorldOffset));
        tri.colorC = GetBlendedColor(tri.c + float3(WorldOffset));
        Triangles.Append(tri);
    }
}
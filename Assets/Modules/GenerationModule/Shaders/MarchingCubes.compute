#pragma kernel GenerateDensity
#pragma kernel GenerateMesh

#include "NoiseCommon.hlsl"
#include "SimplexNoise3D.hlsl"
#include "PerlinNoise3D.hlsl"
#include "VoronoiNoise3D.hlsl"

struct Triangle
{
    float3 a;
    float3 b;
    float3 c;
    float4 colorA;
    float4 colorB;
    float4 colorC;
};

// --- BUFFERS ---
RWStructuredBuffer<float> Densities;
AppendStructuredBuffer<Triangle> Triangles;

StructuredBuffer<int2> EdgeVertices;
StructuredBuffer<int> TriTable;
StructuredBuffer<int3> Corners;

int3 ChunkSize;
int3 WorldOffset;
float IsoLevel;
float _Seed;
float _HubScale, _HubThreshold, _BranchScale, _BranchThreshold;


uint GetIndex(uint x, uint y, uint z)
{
    return x + y * (uint) ChunkSize.x + z * (uint) ChunkSize.x * (uint) ChunkSize.y;
}

float4 GetBlendedColor(float3 worldPos)
{
    // [NODE_COLOR_START]
float totalW = 0.0001f; float finalDensity = 0; float4 finalColor = 0; float noise_0 = PerlinNoise(worldPos * 0.0100);
float clamp_1 = clamp(noise_0, 0.0010f, 1.0000f);


        float adv_noise_2 = PerlinNoise_Octaves(worldPos, 0.0100, float3(0.00, 0.00, 0.00), uint(4), 1.2000, 2.0000, 1.0);
float math_3 = 40.0000f - worldPos.y;
float math_4 = adv_noise_2 + math_3;
 
        float weight_5 = pow(saturate(1.0 - abs(clamp_1 - 0.200) * 5.0), 2.0);
        finalDensity += math_4 * weight_5;
        finalColor += float4(1.000, 0.000, 0.000, 1.0f) * weight_5;
        totalW += weight_5;

         
        float weight_6 = pow(saturate(1.0 - abs(clamp_1 - 0.400) * 5.0), 2.0);
        finalDensity += math_4 * weight_6;
        finalColor += float4(0.906, 0.522, 0.020, 1.0f) * weight_6;
        totalW += weight_6;

         
        float weight_7 = pow(saturate(1.0 - abs(clamp_1 - 0.600) * 5.0), 2.0);
        finalDensity += math_4 * weight_7;
        finalColor += float4(0.973, 1.000, 0.000, 1.0f) * weight_7;
        totalW += weight_7;

         
        float weight_8 = pow(saturate(1.0 - abs(clamp_1 - 0.800) * 5.0), 2.0);
        finalDensity += math_4 * weight_8;
        finalColor += float4(0.000, 1.000, 0.071, 1.0f) * weight_8;
        totalW += weight_8;

         
        float weight_9 = pow(saturate(1.0 - abs(clamp_1 - 1.000) * 5.0), 2.0);
        finalDensity += math_4 * weight_9;
        finalColor += float4(0.000, 0.851, 1.000, 1.0f) * weight_9;
        totalW += weight_9; return finalColor / totalW;
    // [NODE_COLOR_END]
    
}

float3 Interpolate(float3 p1, float val1, float3 p2, float val2)
{
    if (abs(IsoLevel - val1) < 0.00001)
        return p1;
    if (abs(IsoLevel - val2) < 0.00001)
        return p2;
    if (abs(val1 - val2) < 0.00001)
        return p1;
    return p1 + (IsoLevel - val1) / (val2 - val1) * (p2 - p1);
}

[numthreads(4, 4, 4)]
void GenerateDensity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) ChunkSize.x || id.y >= (uint) ChunkSize.y || id.z >= (uint) ChunkSize.z)
        return;

    float3 worldPos = float3(id) + float3(WorldOffset);
    float density = 0;

    // [NODE_GRAPH_START]
float totalW = 0.0001f; float finalDensity = 0; float4 finalColor = 0; float noise_0 = PerlinNoise(worldPos * 0.0100);
float clamp_1 = clamp(noise_0, 0.0010f, 1.0000f);


        float adv_noise_2 = PerlinNoise_Octaves(worldPos, 0.0100, float3(0.00, 0.00, 0.00), uint(4), 1.2000, 2.0000, 1.0);
float math_3 = 40.0000f - worldPos.y;
float math_4 = adv_noise_2 + math_3;
 
        float weight_5 = pow(saturate(1.0 - abs(clamp_1 - 0.200) * 5.0), 2.0);
        finalDensity += math_4 * weight_5;
        finalColor += float4(1.000, 0.000, 0.000, 1.0f) * weight_5;
        totalW += weight_5;

         
        float weight_6 = pow(saturate(1.0 - abs(clamp_1 - 0.400) * 5.0), 2.0);
        finalDensity += math_4 * weight_6;
        finalColor += float4(0.906, 0.522, 0.020, 1.0f) * weight_6;
        totalW += weight_6;

         
        float weight_7 = pow(saturate(1.0 - abs(clamp_1 - 0.600) * 5.0), 2.0);
        finalDensity += math_4 * weight_7;
        finalColor += float4(0.973, 1.000, 0.000, 1.0f) * weight_7;
        totalW += weight_7;

         
        float weight_8 = pow(saturate(1.0 - abs(clamp_1 - 0.800) * 5.0), 2.0);
        finalDensity += math_4 * weight_8;
        finalColor += float4(0.000, 1.000, 0.071, 1.0f) * weight_8;
        totalW += weight_8;

         
        float weight_9 = pow(saturate(1.0 - abs(clamp_1 - 1.000) * 5.0), 2.0);
        finalDensity += math_4 * weight_9;
        finalColor += float4(0.000, 0.851, 1.000, 1.0f) * weight_9;
        totalW += weight_9; density = finalDensity / totalW;
    // [NODE_GRAPH_END]
    
    float hM = smoothstep(_HubThreshold, _HubThreshold + 0.05, SimplexNoise(worldPos * _HubScale + _Seed));
    float3 bP1 = worldPos * float3(_BranchScale, _BranchScale * 4.0, _BranchScale);
    float3 bP2 = (worldPos + float3(123, 456, 789)) * float3(_BranchScale, _BranchScale * 4.0, _BranchScale);
    float bM = 1.0 - smoothstep(_BranchThreshold - 0.01, _BranchThreshold, (SimplexNoise(bP1) * SimplexNoise(bP1) + SimplexNoise(bP2) * SimplexNoise(bP2)));

    density = lerp(density, -15.0, max(hM, bM));
    if (worldPos.y < -45.0)
        density = 30.0;
    
    Densities[GetIndex(id.x, id.y, id.z)] = density;
}

[numthreads(4, 4, 4)]
void GenerateMesh(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) (ChunkSize.x - 1) || id.y >= (uint) (ChunkSize.y - 1) || id.z >= (uint) (ChunkSize.z - 1))
        return;

    float dens[8];
    int cubeIdx = 0;
    for (int i = 0; i < 8; i++)
    {
        dens[i] = Densities[GetIndex(id.x + Corners[i].x, id.y + Corners[i].y, id.z + Corners[i].z)];
        if (dens[i] > IsoLevel)
            cubeIdx |= (1 << i);
    }
    if (cubeIdx == 0 || cubeIdx == 255)
        return;

    float3 v[12];
    for (int j = 0; j < 12; j++)
    {
        v[j] = Interpolate(float3(id + Corners[EdgeVertices[j].x]), dens[EdgeVertices[j].x], float3(id + Corners[EdgeVertices[j].y]), dens[EdgeVertices[j].y]);
    }

    int offset = cubeIdx * 16;
    for (int k = 0; k < 16; k += 3)
    {
        if (TriTable[offset + k] == -1)
            break;
        Triangle tri;
        tri.a = v[TriTable[offset + k]];
        tri.b = v[TriTable[offset + k + 1]];
        tri.c = v[TriTable[offset + k + 2]];
        tri.colorA = GetBlendedColor(tri.a + float3(WorldOffset));
        tri.colorB = GetBlendedColor(tri.b + float3(WorldOffset));
        tri.colorC = GetBlendedColor(tri.c + float3(WorldOffset));
        Triangles.Append(tri);
    }
}